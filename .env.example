PORT=8080
SHUTDOWN_TIMEOUT=10s
PLATFORM_DATABASE_URL=postgres://postgres:change-me@localhost:5432/if3110_platform?sslmode=disable
# Required: generate a random base64-encoded 32-byte key (see docs/database-management.md).
DATABASE_ENCRYPTION_KEY=replace-with-your-generated-key
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-long-random-password
APP_ENV=development
# Set COOKIE_SECURE=true when HTTPS terminates in a reverse proxy.
COOKIE_SECURE=false
